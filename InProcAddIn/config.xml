  <Description>在 ArcMap 进程内执行 ArcAI 生成的 Python 2.7 / arcpy 代码。</Description>
  <Version>1.0</Version>
  <Targets>
    <Target name="Desktop" version="10.8" />
  </Targets>
  <AddIn language="PYTHON" library="ArcAIInProc_addin.py" namespace="ArcAIInProc_addin">
    <ArcMap>
      <Commands>
        <Button id="ArcAIInProc_addin.button" class="InProcButton" caption="在 ArcMap 内执行" category="ArcAI" image="Images/ai16.png" />
      </Commands>
      <Toolbars>
        <Toolbar id="ArcAIInProc_addin.toolbar" caption="ArcAI InProc" showInitially="true">
          <Items>
            <Button refID="ArcAIInProc_addin.button" />
          </Items>
        </Toolbar>
      </Toolbars>
    </ArcMap>
  </AddIn>
</ESRI.Configuration>
